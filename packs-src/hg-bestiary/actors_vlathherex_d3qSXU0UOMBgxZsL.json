    {
      "_id": "SiuRcpryFloO00x4",
      "_key": "!actors.items!d3qSXU0UOMBgxZsL.SiuRcpryFloO00x4",
      "_stats": {
        "coreVersion": "13.351",
        "systemId": "pf1",
        "systemVersion": "11.9",
        "compendiumSource": "Compendium.pf1.feats.Item.FUW5mIXHNBBIQ1Sq"
      },
      "img": "systems/pf1/icons/feats/power-attack.jpg",
      "name": "Power Attack",
      "system": {
        "description": {
          "value": "<i>You can make exceptionally deadly melee attacks by sacrificing accuracy for strength.</i><p><strong>Prerequisites</strong>: Str 13, base attack bonus +1.</p><p><strong>Benefits</strong>: You can choose to take a -1 penalty on all melee attack rolls and combat maneuver checks to gain a +2 bonus on all melee damage rolls. This bonus to damage is increased by half (+50%) if you are making an attack with a two-handed weapon, a one handed weapon using two hands, or a primary natural weapon that adds 1-1/2 times your Strength modifier on damage rolls. This bonus to damage is halved (-50%) if you are making an attack with an off-hand weapon or secondary natural weapon. When your base attack bonus reaches +4, and every 4 points thereafter, the penalty increases by -1 and the bonus to damage increases by +2. You must choose to use this feat before making an attack roll, and its effects last until your next turn. The bonus damage does not apply to touch attacks or effects that do not deal hit point damage.</p>"
        },
        "sources": [
          {
            "id": "PZO1110",
            "pages": "116, 131"
          }
        ],
        "tags": [
          "Combat",
          "Offensive"
        ]
      },
      "type": "feat"
    },
    {
      "_id": "2RhAULf4LV8zm05h",
      "_key": "!actors.items!d3qSXU0UOMBgxZsL.2RhAULf4LV8zm05h",
      "_stats": {
        "coreVersion": "13.351",
        "systemId": "pf1",
        "systemVersion": "11.9",
        "compendiumSource": "Compendium.pf1.feats.Item.kn854Ovz0BDA2Dgz"
      },
      "img": "systems/pf1/icons/feats/shatter-defenses.jpg",
      "name": "Shatter Defenses",
      "system": {
        "description": {
          "value": "<p><em>Your skill with your chosen weapon leaves opponents unable to defend themselves if you strike them when their defenses are already compromised.</em></p><p><strong>Prerequisites</strong>: @UUID[Compendium.pf1.feats.Item.n250dFlbykAIAg5Z]{Weapon Focus}, @UUID[Compendium.pf1.feats.Item.3cq9YbgcMrAXC76j]{Dazzling Display}, base attack bonus +6, proficiency with weapon.</p><p><strong>Benefits</strong>: Any shaken, frightened, or panicked opponent hit by you this round is flat-footed to your attacks until the end of your next turn. This includes any additional attacks you make this round.</p>"
        },
        "sources": [
          {
            "id": "PZO1110",
            "pages": "117, 133"
          }
        ],
        "tags": [
          "Combat",
          "Offensive"
        ]
      },
      "type": "feat"
    },
    {
      "_id": "fO1IPJFyOZ2iOTi4",
      "_key": "!actors.items!d3qSXU0UOMBgxZsL.fO1IPJFyOZ2iOTi4",
      "_stats": {
        "coreVersion": "13.351",
        "systemId": "pf1",
        "systemVersion": "11.9",
        "compendiumSource": "Compendium.pf1.feats.Item.8snLqsJN4LLL00Nq"
      },
      "img": "systems/pf1/icons/feats/toughness.jpg",
      "name": "Toughness",
      "system": {
        "description": {
          "value": "<i>You have enhanced physical stamina.</i><p><strong>Benefits</strong>: You gain +3 hit points. For every Hit Die you possess beyond 3, you gain an additional +1 hit point. If you have more than 3 Hit Dice, you gain +1 hit points whenever you gain a Hit Die (such as when you gain a level).</p>"
        },
        "sources": [
          {
            "id": "PZO1110",
            "pages": "116, 135"
          }
        ],
        "tags": [
          "General",
          "Defensive"
        ]
      },
      "type": "feat"
    },
    {
      "_id": "APnxZgrcnPS5fiKz",
      "_key": "!actors.items!d3qSXU0UOMBgxZsL.APnxZgrcnPS5fiKz",
      "_stats": {
        "coreVersion": "13.351",
        "systemId": "pf1",
        "systemVersion": "11.9",
        "compendiumSource": "Compendium.pf1.feats.Item.26k1Gi7t5BoqxhIj"
      },
      "img": "systems/pf1/icons/feats/vital-strike.jpg",
      "name": "Vital Strike",
      "system": {
        "description": {
          "instructions": "<p>Add conditional modifier with <code>@base.dice</code> as damage formula where desired.</p>",
          "value": "<i>You make a single attack that deals significantly more damage than normal.</i><p><strong>Prerequisites</strong>: Base attack bonus +6.</p><p><strong>Benefits</strong>: When you use the attack action, you can make one attack at your highest base attack bonus that deals additional damage. Roll the weapon's damage dice for the attack twice and add the results together before adding bonuses from Strength, weapon abilities (such as <i>flaming</i>), precision based damage, and other damage bonuses. These extra weapon damage dice are not multiplied on a critical hit, but are added to the total.</p>"
        },
        "sources": [
          {
            "id": "PZO1110",
            "pages": "117, 136"
          }
        ],
        "tags": [
          "Combat",
          "Offensive"
        ]
      },
      "type": "feat"
    },
    {
      "_id": "DEpPNupxfDe5cZbG",
      "_key": "!actors.items!d3qSXU0UOMBgxZsL.DEpPNupxfDe5cZbG",
      "_stats": {
        "coreVersion": "13.351",
        "systemId": "pf1",
        "systemVersion": "11.9",
        "compendiumSource": "Compendium.pf1.feats.Item.n250dFlbykAIAg5Z"
      },
      "img": "systems/pf1/icons/feats/weapon-focus.jpg",
      "name": "Weapon Focus (Scimitar)",
      "system": {
        "description": {
          "value": "<i>Choose one type of weapon. You can also choose unarmed strike or grapple (or ray, if you are a spellcaster) as your weapon for the purposes of this feat.</i><p><strong>Prerequisites</strong>: Proficiency with selected weapon, base attack bonus +1.</p><p><strong>Benefits</strong>: You gain a +1 bonus on all attack rolls you make using the selected weapon.</p><p><strong>Special</strong>: You can gain this feat multiple times. Its effects do not stack. Each time you take the feat, it applies to a new type of weapon.</p>"
        },
        "sources": [
          {
            "id": "PZO1110",
            "pages": "117, 136"
          }
        ],
        "tags": [
          "Combat",
