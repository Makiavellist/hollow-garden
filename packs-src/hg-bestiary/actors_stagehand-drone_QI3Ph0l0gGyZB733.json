    {
      "_id": "cWoevn2niUAiOSfB",
      "name": "Force Field",
      "type": "feat",
      "img": "icons/magic/control/debuff-energy-hold-levitate-teal-blue.webp",
      "system": {
        "subType": "misc",
        "abilityType": "ex",
        "description": {
          "value": "<p>The robot is sheathed in a force field with <strong>40 hit points</strong> and <strong>fast healing 8</strong>. Damage is applied to the force field before the robot's own hit points, and the fast healing applies only to the field. A field reduced to 0 hp goes down and regenerates at its fast healing rate.</p><p><em>Track the force field as this actor's temporary hit points.</em></p>"
        }
      },
      "_key": "!actors.items!QI3Ph0l0gGyZB733.cWoevn2niUAiOSfB",
